generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  WARNING
}

enum ConnectionType {
  WIFI
  WIRED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  fullName     String?  @map("full_name")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  devices Device[]
  deviceGroups DeviceGroup[]

  @@map("users")
}

model Device {
  id             String  @id @default(uuid()) @db.Uuid
  deviceUid      String  @unique @map("device_uid")
  activationCode String  @unique @map("activation_code")
  userId         String? @db.Uuid @map("user_id")

  // Basic metadata
  type  String @default("sensor")
  model String @default("WIFI-X1")
  name  String @default("")

  // Connection/network metadata
  connectionType ConnectionType @default(WIFI) @map("connection_type")

  // Optional runtime state
  lightOn        Boolean? @map("light_on")
  acOn           Boolean? @map("ac_on")
  acTargetTempC  Int?     @map("ac_target_temp_c")
  cameraFrameUrl String?  @map("camera_frame_url")

  status     DeviceStatus @default(OFFLINE)
  telemetryBlocked Boolean @default(false) @map("telemetry_blocked")
  lastSeenAt DateTime?    @map("last_seen_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  telemetry Telemetry[]
  controlOverride DeviceControlOverride?
  groupMembers DeviceGroupMember[]

  @@index([userId])
  @@index([connectionType])
  @@map("devices")
}

model Telemetry {
  id           String   @id @default(uuid()) @db.Uuid
  deviceId     String   @db.Uuid @map("device_id")
  ts           DateTime @map("ts")
  temperatureC Float    @map("temperature_c")
  humidityPct  Float    @map("humidity_pct")
  signalDbm    Float?   @map("signal_dbm")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, ts])
  @@map("telemetry")
}

model DeviceControlTemplate {
  id         String   @id @default(uuid()) @db.Uuid
  deviceType String   @unique @map("device_type")
  config     Json     @map("config")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("device_control_templates")
}

model DeviceControlOverride {
  id        String   @id @default(uuid()) @db.Uuid
  deviceId  String   @unique @db.Uuid @map("device_id")
  config    Json     @map("config")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@map("device_control_overrides")
}

model DeviceGroup {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  name      String   @map("name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  members  DeviceGroupMember[]

  @@index([userId])
  @@map("device_groups")
}

model DeviceGroupMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @db.Uuid @map("group_id")
  deviceId String   @db.Uuid @map("device_id")
  createdAt DateTime @default(now()) @map("created_at")

  group  DeviceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  device Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([groupId, deviceId])
  @@index([deviceId])
  @@map("device_group_members")
}